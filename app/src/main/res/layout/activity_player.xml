<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- match_parent + centre: VideoView shrinks itself to the video's aspect ratio. -->
    <VideoView
        android:id="@+id/video"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"/>

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlayDim"/>

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/btn_back"
            android:layout_height="@dimen/btn_back"
            android:layout_gravity="top|start"
            android:layout_margin="20dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/player_back"
            android:padding="20dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="@dimen/btn_small"
                android:layout_height="@dimen/btn_small"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/player_previous"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_previous"/>

            <ImageButton
                android:id="@+id/btn_play"
                android:layout_width="@dimen/btn_play"
                android:layout_height="@dimen/btn_play"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/player_pause"
                android:padding="22dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pause"/>

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="@dimen/btn_small"
                android:layout_height="@dimen/btn_small"
                android:layout_marginStart="20dp"
                android:background="@drawable/bg_round_button"
                android:contentDescription="@string/player_next"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_next"/>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_replay"
            android:layout_width="@dimen/btn_small"
            android:layout_height="@dimen/btn_small"
            android:layout_gravity="bottom|end"
            android:layout_marginBottom="50dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="@string/player_replay"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_replay"/>
    </FrameLayout>

    <!-- Display only. There is deliberately no seek bar. -->
    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="bottom"
        android:clickable="false"
        android:focusable="false"
        android:indeterminate="false"
        android:max="1000"
        android:maxHeight="4dp"
        android:minHeight="4dp"
        android:progressDrawable="@drawable/progress_bar"/>

    <LinearLayout
        android:id="@+id/error_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxWidth="440dp"
            android:text="@string/player_error_title"
            android:textColor="@color/textPrimary"
            android:textSize="28sp"
            android:textStyle="bold"/>

        <Button
            android:id="@+id/error_button"
            android:layout_width="wrap_content"
            android:layout_height="72dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_button_accent"
            android:minWidth="240dp"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:text="@string/player_error_button"
            android:textAllCaps="false"
            android:textColor="@color/onAccent"
            android:textSize="22sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/carousel_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/carousel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim"
            android:clickable="true"/>

        <LinearLayout
            android:id="@+id/carousel_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:paddingTop="16dp">

            <HorizontalScrollView
                android:id="@+id/carousel_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/carousel_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
